# EvalForge configuration. Copy to `.env` and adjust. Never commit `.env`.
# Nested settings use a double underscore: EVALFORGE_<SECTION>__<FIELD>.

# --- Core --------------------------------------------------------------------
EVALFORGE_ENVIRONMENT=development
# SQLite development mode (default) ...
EVALFORGE_DATABASE_URL=sqlite:///./evalforge.db
# ... or PostgreSQL (docker compose sets this automatically):
# EVALFORGE_DATABASE_URL=postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge
EVALFORGE_LOG_LEVEL=INFO
EVALFORGE_LOG_JSON=true

# --- Feature flags -------------------------------------------------------------
# Offline mode forces deterministic mock embeddings, judge and labeler. No API keys needed.
EVALFORGE_OFFLINE_MODE=true
EVALFORGE_DEMO_MODE=false

# --- Log sources (JSON list; can also be created through the API or CLI) -------
# EVALFORGE_SOURCES=[{"name":"app-logs","kind":"json_logs","config":{"path":"logs/*.jsonl"}}]

# --- PII redaction ---------------------------------------------------------------
EVALFORGE_REDACTION__ENABLED=true
EVALFORGE_REDACTION__NER_ENABLED=true
# EVALFORGE_REDACTION__BUILTIN_RULES=["email","credit_card","ssn","phone","ip_address","api_key","iban"]
# EVALFORGE_REDACTION__CUSTOM_RULES=[{"name":"employee_id","pattern":"EMP-\\d{6}","replacement":"[EMPLOYEE_ID]"}]
# EVALFORGE_REDACTION__DROP_METADATA_KEYS=["user_email","user_name","ip","phone","address"]

# --- Sampling ----------------------------------------------------------------------
EVALFORGE_SAMPLING__STRATEGY=signal_boosted   # uniform | stratified | signal_boosted
EVALFORGE_SAMPLING__SAMPLE_SIZE=60
EVALFORGE_SAMPLING__SEED=42
EVALFORGE_SAMPLING__EXCLUDE_PREVIOUSLY_SAMPLED=true
# EVALFORGE_SAMPLING__LOOKBACK_DAYS=7

# --- Embeddings ----------------------------------------------------------------------
EVALFORGE_EMBEDDING__PROVIDER=mock            # mock | openai_compatible
EVALFORGE_EMBEDDING__MODEL=mock-embedding-256
EVALFORGE_EMBEDDING__DIMENSIONS=256
# EVALFORGE_EMBEDDING__BASE_URL=https://api.openai.com/v1
# EVALFORGE_EMBEDDING__API_KEY_ENV=OPENAI_API_KEY

# --- Clustering ------------------------------------------------------------------------
EVALFORGE_CLUSTERING__MIN_CLUSTER_SIZE=5
EVALFORGE_CLUSTERING__MIN_SAMPLES=2
EVALFORGE_CLUSTERING__REDUCE_DIMENSIONS=15
EVALFORGE_CLUSTERING__CONTEXT_WINDOW=2000
EVALFORGE_CLUSTERING__MATCH_THRESHOLD=0.72
EVALFORGE_CLUSTERING__ASSIGN_THRESHOLD=0.6

# --- Judge (quality rating, cluster naming, LLM grading) ---------------------------------
EVALFORGE_JUDGE__PROVIDER=mock
EVALFORGE_JUDGE__MODEL=gpt-4o-mini
# EVALFORGE_JUDGE__BASE_URL=https://api.openai.com/v1
# EVALFORGE_JUDGE__API_KEY_ENV=OPENAI_API_KEY

# --- Labeling ------------------------------------------------------------------------------
EVALFORGE_LABELING__PROVIDER=mock
EVALFORGE_LABELING__MODEL=gpt-4o
EVALFORGE_LABELING__PASSES=3
EVALFORGE_LABELING__AUTO_ACCEPT_CONFIDENCE=0.8
EVALFORGE_LABELING__MAX_CANDIDATES_PER_RUN=40
# EVALFORGE_LABELING__BASE_URL=https://api.openai.com/v1
# EVALFORGE_LABELING__API_KEY_ENV=OPENAI_API_KEY

# --- Deduplication ---------------------------------------------------------------------------
EVALFORGE_DEDUP__SIMILARITY_THRESHOLD=0.92

# --- Evaluation endpoint (default target; can be overridden per run) ---------------------------
EVALFORGE_EVALUATION__PROVIDER=mock
EVALFORGE_EVALUATION__MODEL=mock-model-v1
EVALFORGE_EVALUATION__BASE_URL=https://api.openai.com/v1
EVALFORGE_EVALUATION__API_KEY_ENV=OPENAI_API_KEY
EVALFORGE_EVALUATION__TEMPERATURE=0.0
EVALFORGE_EVALUATION__MAX_TOKENS=1024
EVALFORGE_EVALUATION__TIMEOUT_S=60
EVALFORGE_EVALUATION__MAX_RETRIES=2
EVALFORGE_EVALUATION__CONCURRENCY=8
EVALFORGE_EVALUATION__GRADING_MODE=deterministic   # deterministic | llm | hybrid
EVALFORGE_EVALUATION__PASS_SCORE_TOLERANCE=1.0

# --- Regression thresholds ------------------------------------------------------------------------
EVALFORGE_REGRESSION__SCORE_CHANGE_THRESHOLD=1.0
EVALFORGE_REGRESSION__CATEGORY_SHIFT_THRESHOLD=0.10
EVALFORGE_REGRESSION__DIFFICULTY_SHIFT_THRESHOLD=0.10
EVALFORGE_REGRESSION__OVERALL_PASS_RATE_DROP_THRESHOLD=0.05

# --- Scheduler (nightly pipeline) --------------------------------------------------------------------
EVALFORGE_SCHEDULER__ENABLED=false
EVALFORGE_SCHEDULER__CRON=0 2 * * *
EVALFORGE_SCHEDULER__TIMEZONE=UTC
EVALFORGE_SCHEDULER__RUN_EVALUATION=true

# --- Write protection (API + dashboard) -----------------------------------------------------------------
EVALFORGE_AUTH__MODE=local_dev                # local_dev | token
# Required when EVALFORGE_AUTH__MODE=token. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# EVALFORGE_AUTH_TOKEN=

# --- Secrets (referenced by *_API_KEY_ENV above; never commit real values) --------------------------------
# OPENAI_API_KEY=
